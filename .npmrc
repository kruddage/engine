# Fail rather than silently running under a Node older than a package declares.
# The floor is `engines.node` in each manifest (>=20.11); .nvmrc pins the one
# version CI and a contributor's version manager actually run. The floor says
# what is supported, the pin says what is tested — they are different facts and
# both are written once.
engine-strict=true

# Workspace packages resolve to each other by link, never by a registry
# download — a `workspace:*` range that cannot be satisfied locally is an
# error rather than a silent fetch of some unrelated published package.
link-workspace-packages=true
prefer-workspace-packages=true

# `resolution-mode=highest` used to sit here. It arbitrates between competing
# versions of third-party packages, and this workspace has none — pnpm-lock.yaml
# is a few hundred bytes of importers and `link:` edges with not one registry
# dependency (WORKSPACE.md, Q1). A setting nothing reads back is not worth its
# line: it reads as a decision someone made about a dependency graph, and there
# is no graph for it to have been a decision about. If a dependency ever
# arrives, this is the moment to choose a resolution mode on purpose.
