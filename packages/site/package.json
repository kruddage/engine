{
	"name": "@kruddage/site",
	"version": "0.0.0",
	"private": true,
	"description": "Stages the deployable static site from @kruddage/engine's artifacts. Replaces .github/scripts/stage-site.sh.",
	"license": "GPL-2.0-or-later",
	"type": "module",
	"engines": {
		"node": ">=20.11"
	},
	"scripts": {
		"build": "node scripts/build.mjs",
		"test": "node --test test/*.test.mjs",
		"clean": "node -e \"require('node:fs').rmSync('dist',{recursive:true,force:true})\""
	},
	"dependencies": {
		"@kruddage/editor": "workspace:*",
		"@kruddage/engine": "workspace:*"
	}
}
