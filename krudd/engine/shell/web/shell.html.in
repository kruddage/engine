<!DOCTYPE html>
<html lang="en">
<head>
<meta charset="utf-8">
<meta name="viewport" content="width=device-width, initial-scale=1, viewport-fit=cover">
<title>@PROJECT_NAME@ @PROJECT_VERSION@</title>
<!-- Inline SVG favicon (data URI, no network fetch) so browsers stop
     requesting /favicon.ico and logging a 404 on every load. -->
<link rel="icon" href="data:image/svg+xml,%3Csvg%20xmlns='http://www.w3.org/2000/svg'%20viewBox='0%200%2032%2032'%3E%3Crect%20width='32'%20height='32'%20fill='%230d0d0d'/%3E%3Ctext%20x='16'%20y='23'%20font-family='Courier%20New,monospace'%20font-size='22'%20font-weight='700'%20fill='%23ffffff'%20text-anchor='middle'%3EK%3C/text%3E%3C/svg%3E">
<link rel="manifest" href="manifest.webmanifest">
<link rel="apple-touch-icon" href="icon-192.png">
<meta name="theme-color" content="#0d0d0d">
<meta name="apple-mobile-web-app-capable" content="yes">
<meta name="apple-mobile-web-app-status-bar-style" content="black-translucent">
<meta name="apple-mobile-web-app-title" content="KRUDD">
<style>
*, *::before, *::after { box-sizing: border-box; margin: 0; padding: 0; }

body {
	background: #0d0d0d;
	color: #e0e0e0;
	font-family: 'Courier New', Courier, monospace;
	/*
	 * dvh (dynamic viewport height) tracks the *visible* viewport, so the
	 * app shrinks to fit above a mobile browser's dynamic toolbar instead
	 * of extending behind it — otherwise 100vh (the large viewport) hides
	 * the bottom strip of the canvas, and with it kruddgui's bottom-anchored
	 * panels (the mode-bar, the Log handle), under Firefox Android's URL bar.
	 * The 100vh line is the fallback for browsers without dvh.
	 */
	height: 100vh;
	height: 100dvh;
	display: flex;
	flex-direction: column;
	overflow: hidden;
}

/*
 * ── Canvas viewport ──
 *
 * The page is the canvas plus the overlays that sit over it (the picker, the
 * error box). The DOM editor chrome that used to frame it — menu bar, toolbar,
 * docks and status bar, all built at runtime from a layout spec the engine
 * serialized out of Scheme — is gone, so the canvas is a plain flex child of
 * <body> and has the whole viewport to itself in every state the page has.
 */

.canvas-wrap {
	flex: 1;
	display: flex;
	align-items: center;
	justify-content: center;
	background: #000;
	min-height: 0;
	min-width: 0;
}

canvas {
	display: block;
	max-width: 100%;
	max-height: 100%;
	width: 100%;
	height: 100%;
}

/*
 * Scrolling diagnostic log for WebGPU bring-up, opt-in behind ?webgpulog=1
 * (see the panel's rationale where it is wired up). A lightweight shell-side
 * panel that carries the backend's step-by-step messages with full history —
 * unlike the single-line status bar. Hidden until the first line arrives.
 */
.webgpu-log {
	position: fixed;
	left: 0;
	right: 0;
	bottom: 30px;
	max-height: 42vh;
	overflow-y: auto;
	background: rgba(0, 0, 0, 0.74);
	border-top: 1px solid #333;
	font-family: 'Courier New', Courier, monospace;
	font-size: 11px;
	line-height: 1.55;
	color: #d0d0d0;
	padding: 8px 14px;
	z-index: 6000;
	display: none;
}

.webgpu-log.visible { display: block; }

.webgpu-log .line { white-space: pre-wrap; }

.webgpu-log .line.err { color: #e07a7a; }

/*
 * ── The picker ──
 *
 * The page's one overlay, and the whole of what a bare URL opens: the projects
 * this build shipped, and a way to open a .scm off the device. It is a
 * destination rather than a splash on the way to a game — nothing here is
 * dismissed by waiting — which is also why it is what the "load project"
 * control in the corner brings back over a running scene, instead of a second
 * panel saying the same thing somewhere else on the page.
 *
 * The engine opens its staged project behind this overlay on a bare URL (#1034,
 * see finish_plugin_boot in core/engine.c), so the × reveals a scene rather than
 * a clear colour. That is a backdrop, not a pick: the picker stays up until
 * something is chosen, and the URL keeps saying nothing is.
 *
 * Picking a shipped project navigates to ?game=<name>. That is the whole of
 * "open this instead": the page reloads into a fresh engine with the project
 * named in the URL, so there is no scene to tear down and no state to reset,
 * and a link to a project is just a link. Only a file off the device is loaded
 * in place, because there is no URL that could name it.
 */

.launcher {
	position: fixed;
	inset: 0;
	background: rgba(13, 13, 13, 0.96);
	display: flex;
	align-items: center;
	justify-content: center;
	z-index: 5000;
	padding: 20px;
}

.launcher.hidden { display: none; }

.launcher-close {
	position: absolute;
	top: 16px;
	right: 20px;
	width: 28px;
	height: 28px;
	background: none;
	border: 1px solid #333;
	color: #888;
	font-family: inherit;
	font-size: 18px;
	line-height: 1;
	cursor: pointer;
}

.launcher-close:hover { border-color: #555; color: #ccc; }

/* Matches .launcher-sub/.launcher-body: no dismissing a picker that hasn't
 * armed its buttons yet (see kruddSetReady below). */
.launcher.loading .launcher-close { display: none; }

.launcher-panel {
	display: flex;
	flex-direction: column;
	align-items: center;
	gap: 10px;
	width: 100%;
	max-width: 360px;
}

.launcher-title {
	font-size: 32px;
	font-weight: bold;
	letter-spacing: 0.3em;
	color: #fff;
}

.launcher-sub {
	font-size: 12px;
	color: #666;
	letter-spacing: 0.15em;
	text-transform: uppercase;
	margin-bottom: 14px;
}

/*
 * Until the engine has rendered its first frame the picker is painted (static
 * HTML) but not yet armed: the list is hidden and a "loading" note stands in, so
 * an impatient click has no button to hit. The engine flips the .loading class
 * off via kruddSetReady once it is live.
 *
 * The wordmark is hidden along with it, so a page opened ON a project — which
 * takes this overlay down the moment the scene is up — shows a bare "loading"
 * and then the board, never a splash screen standing between the player and the
 * game. The title is back on a bare URL, where the picker is where the page was
 * going all along.
 */
.launcher-loading {
	display: none;
	font-size: 12px;
	color: #666;
	letter-spacing: 0.15em;
	text-transform: uppercase;
}

.launcher.loading .launcher-loading { display: block; }

.launcher.loading .launcher-title,
.launcher.loading .launcher-sub,
.launcher.loading .launcher-body { display: none; }

.launcher-body,
.launcher-list {
	display: flex;
	flex-direction: column;
	gap: 10px;
	width: 100%;
}

.launcher-label {
	font-size: 11px;
	color: #555;
	letter-spacing: 0.15em;
	text-transform: uppercase;
	margin-top: 6px;
}

.launcher-btn {
	background: #141414;
	border: 1px solid #333;
	border-left: 3px solid #2d6a2d;
	color: #ddd;
	font-family: inherit;
	font-size: 15px;
	letter-spacing: 0.08em;
	padding: 14px 18px;
	cursor: pointer;
	text-align: left;
	transition: border-color 0.12s, background 0.12s;
}

.launcher-btn:hover {
	background: #1c1c1c;
	border-color: #555;
	border-left-color: #4a9a4a;
	color: #fff;
}

/*
 * ── Load Project ──
 *
 * The engine's one piece of permanent chrome: what brings the picker back over
 * a running scene. Opening a project is not a boot step, it is the thing the
 * page is for, so it has to be reachable from the game a project is already
 * running — hence a control parked in the corner rather than an overlay that
 * only exists on the way in.
 *
 * It sits in the top-left because the engine's own UI (kruddgui) anchors to the
 * bottom of the viewport, and it is dim until hovered so that a corner of a
 * running game is not spending its contrast on a button.
 */
.launcher-open {
	position: fixed;
	top: 10px;
	left: 10px;
	/* Above the picker it opens (5000) and below the error box (9999): the
	 * one control that is reachable from every state the page has, the
	 * picker itself included — where it is a no-op, and still there rather
	 * than blinking out on the one screen that already says what it does. */
	z-index: 5200;
	background: rgba(20, 20, 20, 0.72);
	border: 1px solid #2a2a2a;
	border-left: 3px solid #2d6a2d;
	color: #777;
	font-family: inherit;
	font-size: 11px;
	letter-spacing: 0.12em;
	text-transform: uppercase;
	padding: 5px 10px;
	cursor: pointer;
	opacity: 0.55;
	transition: opacity 0.12s, border-color 0.12s, color 0.12s;
}

.launcher-open:hover {
	opacity: 1;
	border-color: #555;
	border-left-color: #4a9a4a;
	color: #ddd;
}

/*
 * ── Enter VR (#997) ──
 *
 * A persistent corner control, the same shape as .launcher-open and for the
 * same reason: the moment a player wants VR is not necessarily the moment
 * the picker happens to be up, so the control cannot live inside it. It sits
 * in the opposite corner (top-right) so the two never contend for the same
 * spot, and is dim-until-hover for the same reason .launcher-open is — a
 * corner of a running game should not spend its contrast on chrome.
 *
 * kruddXrRender (below, in the script) is the only thing that ever shows it:
 * hidden is the resting state, and it is lifted only once there is something
 * honest to offer — see the three visible states next to that function.
 * Nothing here guesses; xr-control[hidden] is plain HTML `hidden`, so a
 * browser with no script running at all (JS disabled) never shows a button
 * that cannot do anything.
 */
.xr-control {
	position: fixed;
	top: 10px;
	right: 10px;
	z-index: 5200;
	background: rgba(20, 20, 20, 0.72);
	border: 1px solid #2a2a2a;
	border-left: 3px solid #2d6a2d;
	color: #777;
	font-family: inherit;
	font-size: 11px;
	letter-spacing: 0.12em;
	text-transform: uppercase;
	padding: 5px 10px;
	cursor: pointer;
	opacity: 0.55;
	transition: opacity 0.12s, border-color 0.12s, color 0.12s;
}

.xr-control[hidden] { display: none; }

.xr-control:hover {
	opacity: 1;
	border-color: #555;
	border-left-color: #4a9a4a;
	color: #ddd;
}

/*
 * The "exit vr" state reads differently from "enter"/"reload" on purpose —
 * the accent goes toward the error palette's red rather than the launcher's
 * green, so the control's meaning changes with its label instead of only
 * its text. It is still calm (not .error-box's saturated red): ending a
 * session on purpose is the ordinary case, not a fault.
 */
.xr-control.active {
	border-left-color: #8a3a3a;
}

.xr-control.active:hover {
	border-left-color: #c0392b;
}

/*
 * ── "you're back" note ──
 *
 * Where a session that ended without the page's own button asking for it
 * gets explained (#997's exit-path requirement): the system menu and an
 * in-session failure both surface here, because from the page's side they
 * are the same observation — xr_session_active() went from 1 to 0 without
 * kruddXrClick()'s "exit" branch having set kruddXrEndedByUs first (see the
 * script). It cannot say WHY beyond that — the specific reason is on the
 * console, same as it always was (xr_state.c's end_line) — so it says that
 * plainly rather than guessing.
 *
 * Deliberately not the modal .error-backdrop: most of what lands here is a
 * player choosing to take the headset off, not a fault, and the error
 * overlay's red "!" would call that a bug it is not. A quiet corner note
 * that names where the real detail lives is the honest version of both
 * cases at once.
 */
.xr-note {
	position: fixed;
	left: 50%;
	bottom: 24px;
	transform: translateX(-50%);
	z-index: 5300;
	max-width: 420px;
	background: rgba(15, 15, 15, 0.92);
	border: 1px solid #333;
	border-top: 3px solid #2d6a2d;
	color: #ccc;
	font-family: inherit;
	font-size: 12px;
	line-height: 1.5;
	padding: 12px 16px;
	display: flex;
	align-items: center;
	gap: 14px;
}

.xr-note[hidden] { display: none; }

.xr-note-dismiss {
	background: none;
	border: 1px solid #333;
	color: #777;
	font-family: inherit;
	font-size: 11px;
	padding: 3px 9px;
	cursor: pointer;
	flex-shrink: 0;
}

.xr-note-dismiss:hover { border-color: #555; color: #ccc; }

/* ── Error overlay ── */

.error-backdrop {
	position: fixed;
	inset: 0;
	background: rgba(0, 0, 0, 0.75);
	display: none;
	align-items: center;
	justify-content: center;
	z-index: 9999;
	padding: 20px;
}

.error-backdrop.visible {
	display: flex;
}

.error-box {
	background: #111;
	border: 1px solid #5a1a1a;
	border-top: 3px solid #c0392b;
	max-width: 720px;
	width: 100%;
	max-height: 80vh;
	display: flex;
	flex-direction: column;
	box-shadow: 0 8px 40px rgba(0, 0, 0, 0.8);
}

.error-header {
	padding: 12px 16px;
	display: flex;
	align-items: center;
	justify-content: space-between;
	gap: 16px;
	border-bottom: 1px solid #2a1a1a;
	flex-shrink: 0;
}

.error-title-row {
	display: flex;
	align-items: center;
	gap: 8px;
	flex: 1;
	min-width: 0;
	overflow: hidden;
}

.error-icon {
	color: #c0392b;
	font-size: 14px;
	font-weight: bold;
	flex-shrink: 0;
}

.error-label {
	font-size: 13px;
	color: #e74c3c;
	font-weight: bold;
	letter-spacing: 0.05em;
	flex-shrink: 0;
}

.error-source {
	font-size: 11px;
	color: #555;
	padding-right: 4px;
}

.error-actions {
	display: flex;
	align-items: center;
	gap: 8px;
	flex-shrink: 0;
}

.error-dismiss,
.error-copy {
	background: none;
	border: 1px solid #333;
	color: #666;
	font-family: inherit;
	font-size: 11px;
	padding: 3px 10px;
	cursor: pointer;
	letter-spacing: 0.05em;
}

.error-dismiss:hover,
.error-copy:hover {
	border-color: #555;
	color: #aaa;
}

.error-copy.copied {
	border-color: #2d6a2d;
	color: #4a9a4a;
}

.error-body {
	padding: 14px 16px;
	overflow-y: auto;
	font-size: 12px;
	line-height: 1.6;
	color: #ccc;
	flex: 1;
	font-family: system-ui, -apple-system, sans-serif;
}

.error-body h2 {
	font-family: 'Courier New', Courier, monospace;
	color: #e74c3c;
	font-size: 13px;
	margin-bottom: 10px;
	font-weight: bold;
	letter-spacing: 0.03em;
}

.error-body h3 {
	font-family: 'Courier New', Courier, monospace;
	color: #b0b0b0;
	font-size: 12px;
	margin: 10px 0 6px;
	font-weight: bold;
	text-transform: uppercase;
	letter-spacing: 0.08em;
}

.error-body p {
	margin-bottom: 8px;
	color: #bbb;
}

.error-body strong { color: #ddd; font-weight: bold; }

.error-body code {
	font-family: 'Courier New', Courier, monospace;
	background: #1a1a1a;
	border: 1px solid #2a2a2a;
	color: #e0a05a;
	padding: 1px 5px;
	font-size: 11px;
	border-radius: 2px;
}

.error-body pre {
	background: #0a0a0a;
	border: 1px solid #222;
	border-left: 3px solid #5a1a1a;
	padding: 10px 12px;
	margin: 8px 0;
	overflow-x: auto;
	font-size: 11px;
	line-height: 1.5;
}

.error-body pre code {
	background: none;
	border: none;
	padding: 0;
	color: #ccc;
	font-size: 11px;
}

.error-body hr {
	border: none;
	border-top: 1px solid #222;
	margin: 10px 0;
}
</style>
</head>
<body>

<div class="canvas-wrap">
	<canvas id="canvas" oncontextmenu="event.preventDefault()"></canvas>
</div>

<div class="webgpu-log" id="webgpu-log"></div>

<div class="launcher loading" id="launcher">
	<button class="launcher-close" id="launcher-close" title="close">&times;</button>
	<div class="launcher-panel">
		<div class="launcher-title">KRUDD</div>
		<div class="launcher-sub">load project</div>
		<div class="launcher-loading">loading&hellip;</div>
		<div class="launcher-body">
			<!-- Filled from assets/projects.json; the label appears with the
			     first button, so a build that shipped nothing says nothing. -->
			<div class="launcher-label" id="launcher-shipped-label" hidden>shipped with this build</div>
			<div class="launcher-list" id="launcher-shipped"></div>
			<div class="launcher-label">from this device</div>
			<button class="launcher-btn" id="launcher-file-btn">choose a .scm file&hellip;</button>
			<!-- An <input type=file> and a FileReader, not the File System Access
			     API: this reads one file once, which is the whole of what that API
			     would buy, and it works in every browser the engine runs in. -->
			<input type="file" id="launcher-file" accept=".scm,text/plain" hidden>
		</div>
	</div>
</div>

<button class="launcher-open" id="launcher-open">load project</button>

<!-- Hidden until kruddXrRender (script below) has an honest state for it —
     see the .xr-control rule for why plain `hidden` is the resting state. -->
<button class="xr-control" id="xr-control" hidden></button>

<div class="xr-note" id="xr-note" hidden>
	<span id="xr-note-text"></span>
	<button class="xr-note-dismiss" id="xr-note-dismiss">dismiss</button>
</div>

<div class="error-backdrop" id="error-backdrop">
	<div class="error-box">
		<div class="error-header">
			<div class="error-title-row">
				<span class="error-icon">!</span>
				<span class="error-label" id="error-label"></span>
			</div>
			<div class="error-actions">
				<span class="error-source">index.wasm</span>
				<button class="error-copy" id="error-copy">copy</button>
				<button class="error-dismiss" id="error-dismiss">dismiss</button>
			</div>
		</div>
		<div class="error-body" id="error-body"></div>
	</div>
</div>

<script>
	function renderMarkdown(src) {
		var lines = src.split('\n');
		var out = '';
		var i = 0;

		function esc(s) {
			return s.replace(/&/g, '&amp;').replace(/</g, '&lt;').replace(/>/g, '&gt;');
		}

		function inline(s) {
			s = esc(s);
			s = s.replace(/\*\*(.+?)\*\*/g, '<strong>$1</strong>');
			s = s.replace(/`([^`]+)`/g, function(_, c) { return '<code>' + c + '</code>'; });
			return s;
		}

		while (i < lines.length) {
			var line = lines[i];

			if (/^```/.test(line)) {
				var code = [];
				i++;
				while (i < lines.length && !/^```/.test(lines[i]))
					code.push(esc(lines[i++]));
				out += '<pre><code>' + code.join('\n') + '</code></pre>';
				i++;
				continue;
			}
			if (/^## /.test(line))  { out += '<h2>' + inline(line.slice(3)) + '</h2>'; i++; continue; }
			if (/^### /.test(line)) { out += '<h3>' + inline(line.slice(4)) + '</h3>'; i++; continue; }
			if (/^---+$/.test(line.trim())) { out += '<hr>'; i++; continue; }
			if (/^\s*$/.test(line)) { i++; continue; }
			out += '<p>' + inline(line) + '</p>';
			i++;
		}
		return out;
	}

	function errorToMarkdown(detail) {
		var m = detail.match(/^([^\n]+)\n([\s\S]+)$/);
		var message = m ? m[1] : detail;
		var stack   = m ? m[2] : null;
		var md = '## ' + message + '\n\n';
		if (stack)
			md += '### Stack trace\n\n```\n' + stack.trim() + '\n```\n';
		return md;
	}

	document.getElementById('error-dismiss').addEventListener('click', function () {
		document.getElementById('error-backdrop').classList.remove('visible');
	});

	document.getElementById('error-copy').addEventListener('click', function () {
		var btn = this;
		var raw = document.getElementById('error-body').dataset.raw || '';
		navigator.clipboard.writeText(raw).then(function () {
			btn.textContent = 'copied!';
			btn.classList.add('copied');
			setTimeout(function () {
				btn.textContent = 'copy';
				btn.classList.remove('copied');
			}, 2000);
		});
	});

	/* Called by error_overlay.js */
	window.kruddShowError = function (title, detail) {
		document.getElementById('error-label').textContent = title;
		var body = document.getElementById('error-body');
		body.dataset.raw = title + ': ' + detail;
		body.innerHTML = renderMarkdown(errorToMarkdown(detail));
		document.getElementById('error-backdrop').classList.add('visible');
	};

	/*
	 * Arm the picker once the first frame is on screen (called from
	 * engine_tick). Dropping the 'loading' class reveals the project list;
	 * before this it is hidden, so a project cannot be picked into an engine
	 * that has not rendered yet.
	 */
	window.kruddSetReady = function () {
		var el = document.getElementById('launcher');
		if (el)
			el.classList.remove('loading');
	};

	/*
	 * Browsers only let an AudioContext leave 'suspended' from inside a
	 * user-gesture handler. Nothing on this page is a tap-to-start any more —
	 * you pick a project and the page navigates into it, so the gesture that
	 * chose the game was spent on the page before this one — and the unlock
	 * therefore rides on the first gesture to land anywhere, a board click
	 * included. Capture phase, so a handler that stops propagation cannot stop
	 * this too; resuming a running context is a no-op, so it can stay armed
	 * rather than having to know which gesture was the first.
	 */
	function resumeAudio() {
		var ctx = window.Module && Module.__kruddAudioCtx;
		if (ctx && ctx.state !== 'running' && ctx.resume)
			ctx.resume();
	}

	window.addEventListener('pointerdown', resumeAudio, true);
	window.addEventListener('keydown', resumeAudio, true);

	function launcher(show) {
		document.getElementById('launcher')
			.classList.toggle('hidden', !show);
	}

	/*
	 * ── The projects this build shipped ──
	 *
	 * assets/projects.json is the list, written by the build from every project
	 * it ships (krudd/kruddmake/ninja.scm): this page cannot list a directory
	 * over HTTP, and it must not carry a filename either — a page that names a
	 * game is a generic shell that knows one, which is the pin #976 pulled out
	 * of the C. Fetched once and shared by the two things that read it: the
	 * picker's list, and the lookup that turns a ?game= name back into the file
	 * to fetch. A build that shipped nothing — or a page opened without the
	 * assets/ directory beside it — answers an empty list, and the picker
	 * offers nothing but the file button.
	 */
	var kruddProjects = fetch('assets/projects.json').then(function (r) {
		return r.ok ? r.json() : [];
	}).then(function (names) {
		return Array.isArray(names) ? names : [];
	}).catch(function () {
		return [];
	});

	/*
	 * What a project is called on its button and in ?game=: its filename
	 * without the extension. The display name inside the .scm is the engine's
	 * — it is what the project registers under, and what ?game= matches for the
	 * project the image embedded — and this page cannot know it without
	 * fetching and running the file first. The two agree by convention
	 * (ducks.scm holds (project "Ducks" ...)); where they would not, the fetch
	 * below opens the project anyway, because it goes by filename.
	 */
	function projectName(file) {
		return String(file).replace(/\.scm$/i, '');
	}

	/*
	 * ── Opening a project ──
	 *
	 * Two ways in, and they are deliberately different.
	 *
	 * A project this build shipped is opened by NAVIGATING to ?game=<name>: the
	 * page reloads into a fresh engine that opens it at boot, so there is no
	 * scene to tear down, nothing to reset, and the URL says what is running —
	 * which also makes a link to a project just a link. A file off the device
	 * has no URL to navigate to, so it goes straight into the running engine
	 * through window.kruddRunProject, which the module installs at boot
	 * (project_install_bridge in game/project/project_host.c) and which answers
	 * the slot the project opened on, or -1. Everything about pointers and the
	 * module heap is on that side of the call: this page hands over a JS string
	 * and reads back a number.
	 */
	function kruddPickProject(name) {
		var q = new URLSearchParams(location.search);

		/* Set rather than replace, so ?renderer=webgl (or ?webgpulog=1)
		 * survives picking a different project — losing them here would
		 * make the picker a way to fall off a diagnostic setting. */
		q.set('game', name);
		location.search = q.toString();
	}

	/*
	 * Run SRC as a project, answering whether it opened. Reporting goes through
	 * the error overlay rather than failing quietly: a .scm that does not load
	 * is the expected case for a button that opens whatever it is pointed at,
	 * so it gets the same treatment as a renderer that would not start — named,
	 * with the reason where it can be read, and the engine still running
	 * whatever it had.
	 */
	function kruddOpenProject(label, src) {
		var run = window.kruddRunProject;

		/* One line each: the overlay reads the first line of a detail as
		 * the message and everything after it as a stack trace (see
		 * errorToMarkdown), and none of these has one. */
		if (typeof run !== 'function') {
			window.kruddShowError('The engine is still starting',
				'It cannot open ' + label + ' until the first frame is up.');
			return false;
		}
		if (run(src) < 0) {
			window.kruddShowError('Could not load ' + label,
				label + ' is not a project the engine could run \u2014 a project is '
				+ 'one .scm holding a (project "Name" ...) form, and the reason this '
				+ 'one was refused is on the engine log (the browser console).');
			return false;
		}
		/* It loaded: the picker it was opened from is stale. Same hide the
		 * C side does when a ?game= opens a project at boot. */
		launcher(false);
		return true;
	}

	/*
	 * Fetch a shipped project's source and run it \u2014 the path a ?game= takes
	 * when the image does not carry that project, since the page is the half of
	 * the engine that can wait on a round trip. A failure leaves the picker up,
	 * because a page that cannot open what its URL asked for should offer what
	 * it can open instead.
	 */
	function kruddFetchProject(file) {
		var url = 'assets/' + encodeURIComponent(file);

		return fetch(url).then(function (r) {
			if (!r.ok)
				throw new Error('HTTP ' + r.status);
			return r.text();
		}).then(function (src) {
			if (!kruddOpenProject(projectName(file), src))
				launcher(true);
		}).catch(function (e) {
			launcher(true);
			window.kruddShowError('Could not fetch ' + file,
				url + ' did not load: ' + String(e));
		});
	}

	/*
	 * ?game=<name> named nothing the image registered (krudd_boot_unresolved in
	 * core/engine.c). For a project the build shipped but did not embed that is
	 * the ordinary case rather than an error: its source is a file in assets/,
	 * so opening it is a fetch, and fetching is this page's half of the job. A
	 * name nothing ships leaves the picker up, which is what ?game=none gets.
	 */
	window.kruddBootProject = function (name) {
		var wanted = String(name).toLowerCase();

		/* Down while the fetch is in flight: this page was opened ON a
		 * project, so the picker is something it is passing through. It
		 * comes back only if the project does not arrive. */
		launcher(false);
		kruddProjects.then(function (files) {
			var found = null;

			files.forEach(function (file) {
				if (projectName(file).toLowerCase() === wanted)
					found = file;
			});
			if (!found) {
				launcher(true);
				return;
			}
			return kruddFetchProject(found);
		});
	};

	/* The corner control brings the picker back over whatever is running; the
	 * × backs out of it without picking anything, leaving the engine (and any
	 * scene already behind the overlay) exactly as it was. */
	document.getElementById('launcher-open').addEventListener('click', function () {
		launcher(true);
	});

	document.getElementById('launcher-close').addEventListener('click', function () {
		launcher(false);
	});

	document.getElementById('launcher-file-btn').addEventListener('click', function () {
		document.getElementById('launcher-file').click();
	});

	document.getElementById('launcher-file').addEventListener('change', function () {
		var input = this;
		var file  = input.files && input.files[0];
		var reader;

		if (!file)
			return;
		/* Cleared so that picking the SAME file again still fires a
		 * change event — re-opening a file you have just edited is the
		 * common case for this button, not a rare one. */
		input.value = '';
		reader = new FileReader();
		reader.onload = function () {
			kruddOpenProject(file.name, String(reader.result));
		};
		reader.onerror = function () {
			window.kruddShowError('Could not read ' + file.name,
				'The browser would not read the file: '
				+ String(reader.error || 'no reason given'));
		};
		reader.readAsText(file);
	});

	/*
	 * The picker's list of what this build ships. Every project appears, the
	 * embedded one included: being embedded is what lets a project open with no
	 * round trip and says nothing about whether it belongs on the menu.
	 */
	kruddProjects.then(function (files) {
		var host  = document.getElementById('launcher-shipped');
		var label = document.getElementById('launcher-shipped-label');

		if (files.length === 0)
			return;
		label.hidden = false;
		files.forEach(function (file) {
			var name = projectName(file);
			var b    = document.createElement('button');

			b.className = 'launcher-btn';
			b.textContent = name;
			b.onclick = function () { kruddPickProject(name); };
			host.appendChild(b);
		});
	});

	/*
	 * Firefox's WebGPU implementation isn't solid enough yet to default to it,
	 * so this forces WebGL there regardless of the ?renderer= query, until
	 * that's revisited. Single source of truth for "should this page run
	 * WebGPU": engine.c's krudd_wants_webgpu reads it through
	 * window.kruddWantsWebGPU, so the page and the actual backend never
	 * disagree about which one is booting.
	 */
	function isFirefox() {
		return /firefox/i.test(navigator.userAgent);
	}

	window.kruddWantsWebGPU = function () {
		try {
			var q = new URLSearchParams(location.search);

			if (isFirefox())
				return false;
			if (q.get('renderer') === 'webgl')
				return false;
			/*
			 * ?xr=1 is "I intend to enter VR" (#997's Enter VR control
			 * writes it into the reload it offers when XR is supported
			 * but this page booted WebGPU). WebXR here is WebGL-only —
			 * xr_js_wants_webgpu in xr_session.c refuses a session on a
			 * WebGPU page and says so in its log line — so wanting XR
			 * implies wanting GL the same way ?renderer=webgl does,
			 * without a link having to spell out both. Checked here
			 * rather than by asking the caller to set ?renderer=webgl
			 * itself so that ?xr=1 stays the one flag meaning "get me to
			 * a page VR can actually run on."
			 */
			if (q.get('xr') === '1')
				return false;
			return true;
		} catch (e) {
			return true;
		}
	};

	/*
	 * Which project the page opens on boot, read once the subsystems are up
	 * (krudd_boot_game in engine.c). ?game=<name> names one: the engine opens
	 * it directly if it embedded it, and otherwise hands the name back for this
	 * page to fetch out of assets/ (kruddBootProject above). ?game=none — or
	 * any name nothing ships — leaves the picker up.
	 *
	 * No ?game= at all answers the empty string, and the engine reads that as
	 * "open the project this build staged" — by launcher slot, not by name, so
	 * the bare URL still has a scene behind its picker without this page (or
	 * the C that boots it) knowing what that scene is called. Naming one here
	 * would be the same pin #976 pulled out of engine.c, just moved into HTML,
	 * which is why the empty string stays empty rather than defaulting to a
	 * filename.
	 */
	window.kruddBootGame = function () {
		try {
			var g = new URLSearchParams(location.search).get('game');
			return g === null ? '' : g;
		} catch (e) {
			return '';
		}
	};

	/*
	 * Which GPU path actually went live. Each backend announces its own name
	 * from its init (renderer_webgl.c, webgpu_platform.c). The toolbar badge
	 * that used to show this went with the editor chrome, so the report now
	 * only reaches the diagnostic channels: the console always, and the
	 * ?webgpulog=1 panel — which is the one that survives on a phone, where
	 * there is no console to open.
	 *
	 * Also the one place the page learns which backend actually booted,
	 * which kruddXrRender (#997) reads through window.kruddRendererName —
	 * kruddWantsWebGPU is what the page ASKED for, this is what it GOT, and
	 * an Enter VR control has to gate on the latter.
	 */
	window.kruddSetRenderer = function (name) {
		var line = 'renderer: ' + name;

		window.kruddRendererName = name;
		if (typeof console !== 'undefined')
			console.log('[krudd] ' + line);
		window.kruddWebGPULog(line);
		if (typeof window.kruddXrRender === 'function')
			window.kruddXrRender();
	};

	/*
	 * The chosen backend gave up — no instance, no adapter, or no device. The
	 * toolbar badge that used to carry this went with the editor chrome, so the
	 * report goes to the error overlay instead. It has to land somewhere: on the
	 * WebGPU path the render cluster and the game only boot once the device
	 * arrives (finish_plugin_boot in engine.c), so a page that says nothing here
	 * is indistinguishable from a slow one, and stays that way. WHY is the
	 * backend's own message; ?renderer=webgl is the way out.
	 */
	window.kruddSetRendererFailed = function (name, why) {
		var label = name === 'webgpu' ? 'WebGPU'
		          : name === 'webgl'  ? 'WebGL'
		          : String(name);

		window.kruddShowError(label + ' failed to start',
			(why || 'the browser returned no device') +
			' — reload with ?renderer=webgl for the WebGL backend.');
	};

	/*
	 * Append a line to the WebGPU probe's diagnostic log panel (see the
	 * .webgpu-log note in the stylesheet). Called from the WebGPU backend via
	 * EM_JS at each step; keeps the panel scrolled to the newest entry.
	 *
	 * Opt-in via ?webgpulog=1. WebGPU is the default renderer now, so this
	 * panel was bring-up scaffolding parked on every user's screen. It stays
	 * reachable rather than deleted because it is the only WebGPU diagnostic
	 * that survives on a phone, where there is no console to open — which is
	 * exactly how the dpr != 1 black screen (#610) got reported.
	 */
	window.kruddWebGPULogEnabled =
		new URLSearchParams(location.search).get('webgpulog') === '1';

	window.kruddWebGPULog = function (msg) {
		var box = document.getElementById('webgpu-log');
		if (!box || !window.kruddWebGPULogEnabled)
			return;
		box.classList.add('visible');
		var line = document.createElement('div');
		line.className = 'line' +
			(/fail|no adapter|no instance|no device|error/i.test(msg) ? ' err' : '');
		line.textContent = msg;
		box.appendChild(line);
		box.scrollTop = box.scrollHeight;
	};

	/*
	 * ── Enter VR (#997) ──
	 *
	 * The xr module (#993) exports five entry points a page calls in —
	 * probe, supported, request_session, end_session, session_active — and
	 * says in its own header that they exist for exactly this control.
	 * Everything below is the state machine that decides what the corner
	 * button (.xr-control) says and does, built entirely from those five
	 * calls plus the two facts the rest of this page already tracks:
	 * kruddWantsWebGPU (what backend the page asked for) and
	 * kruddRendererName (what actually went live, set in kruddSetRenderer
	 * above).
	 *
	 * The exported C functions take no arguments and return void or a plain
	 * int32, so they are called directly as Module._krudd_xr_* — the raw
	 * binding -sEXPORTED_FUNCTIONS produces — rather than through
	 * ccall/cwrap, which exist for marshalling strings and pointers this
	 * traffic never has.
	 */

	/* enum xr_support (xr.h), cached here once the probe answers so the
	 * poll below can stop re-deciding what it already knows. -1 is
	 * XR_SUPPORT_UNKNOWN — the probe has not answered yet, or was never
	 * asked (see kruddXrBoot). */
	var kruddXrSupport = -1;
	var kruddXrSessionActive = false;

	/* Set immediately before this page's own exit click, so the poll below
	 * can tell "we asked for this" apart from a session that ended some
	 * other way — the system menu, or a failure mid-session — which is the
	 * distinction the exit-note decides on (see kruddXrPoll). */
	var kruddXrEndedByUs = false;

	/* Armed by a click on "enter vr", cleared the moment the session
	 * actually goes active. If it is still set once kruddXrRequestTimeout
	 * passes, the request never became a session — refused, or the setup
	 * promise chain rejected — and xr_session.c has already logged which;
	 * this is the page's half, telling the user rather than only the
	 * console (the "session failure is reported somewhere the user will
	 * actually see it" criterion, for the failure case that happens before
	 * the flat page ever goes away). */
	var kruddXrRequestPending = false;
	var kruddXrRequestDeadline = 0;

	/* Generous on purpose: requestSession -> makeXRCompatible ->
	 * XRWebGLLayer -> requestReferenceSpace is four awaited steps
	 * (xr_session.c's setup()), and a slow GPU driver swap inside
	 * makeXRCompatible is exactly the case #993's own note flags as a real
	 * possibility. Firing this early would misreport a session that was
	 * only ever slow to start. */
	var kruddXrRequestTimeoutMs = 8000;

	var kruddXrNoteTimer = null;

	/* Whether ?xr=1 asked to land already focused on the control (the
	 * round trip kruddXrReloadHref below sends the user on). Read once and
	 * cleared after the first successful focus so a later render pass —
	 * the control flipping between enter/exit as a session starts and ends
	 * — does not keep stealing focus back to itself. */
	var kruddXrWantsFocus =
		new URLSearchParams(location.search).get('xr') === '1';

	/* A Module._krudd_xr_* binding, or null before the runtime has produced
	 * it. Every caller below goes through this rather than touching Module
	 * directly, so "the module is not up yet" is one check written once. */
	function kruddXrFn(name) {
		return (window.Module && typeof Module['_' + name] === 'function')
			? Module['_' + name] : null;
	}

	/* Show a message that explains an exit the page's own button did not
	 * ask for (see kruddXrEndedByUs). Auto-hides so it does not become
	 * another permanent fixture the way .webgpu-log deliberately can; it
	 * has said what it has to say once read. */
	function kruddXrNote(text) {
		var box  = document.getElementById('xr-note');
		var body = document.getElementById('xr-note-text');

		if (!box || !body)
			return;
		body.textContent = text;
		box.hidden = false;
		if (kruddXrNoteTimer)
			clearTimeout(kruddXrNoteTimer);
		kruddXrNoteTimer = setTimeout(function () {
			box.hidden = true;
		}, 12000);
	}

	document.getElementById('xr-note-dismiss')
		.addEventListener('click', function () {
			var box = document.getElementById('xr-note');
			if (kruddXrNoteTimer)
				clearTimeout(kruddXrNoteTimer);
			if (box)
				box.hidden = true;
		});

	/*
	 * ?renderer=webgl plus ?xr=1, set rather than replaced — the same
	 * reason kruddPickProject sets 'game' instead of overwriting
	 * location.search: losing ?webgpulog=1 or a project already chosen
	 * would make tapping "reload for vr" a way to fall off a diagnostic or
	 * a running project the user did not ask to leave.
	 */
	function kruddXrReloadHref() {
		var q = new URLSearchParams(location.search);

		q.set('renderer', 'webgl');
		q.set('xr', '1');
		return location.pathname + '?' + q.toString() + location.hash;
	}

	/*
	 * The three honest states, and nothing this control can do outside
	 * them — which is the acceptance criterion "the user should never be
	 * able to reach a broken state by tapping the obvious button" made
	 * literal: there is no fourth state where the button exists and does
	 * something that cannot work.
	 *
	 *   reload  immersive-vr is supported but this page booted WebGPU.
	 *           XRGPUBinding is not broadly shipped (#987), and
	 *           xr_js_wants_webgpu already refuses a session here in C —
	 *           this is what makes that refusal unreachable from the UI,
	 *           by offering the honest route (a reload into the GL
	 *           backend) ahead of the dead end.
	 *   enter   immersive-vr is supported and the GL backend is live.
	 *           Nothing is running yet.
	 *   exit    a session is running. Same control, opposite verb — see
	 *           the .xr-control.active rule for why it looks different too.
	 *
	 * Anything else (support unknown or refused) is not a state this
	 * control has an opinion about: it is hidden, and that is the whole of
	 * "non-XR browsers see no new UI."
	 */
	function kruddXrRender() {
		var el = document.getElementById('xr-control');
		var isGL = window.kruddRendererName === 'webgl';
		var state;

		if (!el || kruddXrSupport !== 0 /* XR_SUPPORT_YES */) {
			if (el)
				el.hidden = true;
			return;
		}

		state = kruddXrSessionActive ? 'exit' : (isGL ? 'enter' : 'reload');
		el.hidden = false;
		el.dataset.state = state;
		el.classList.toggle('active', state === 'exit');
		el.textContent = state === 'reload' ? 'reload for vr'
			: state === 'exit' ? 'exit vr' : 'enter vr';
		el.title = state === 'reload'
			? 'This device supports VR; reload on the WebGL backend to use it.'
			: state === 'exit' ? 'End the VR session.' : 'Enter VR.';

		if (state === 'enter' && kruddXrWantsFocus) {
			kruddXrWantsFocus = false;
			el.focus();
		}
	}

	function kruddXrClick() {
		var el = document.getElementById('xr-control');
		var state = el && el.dataset.state;

		if (state === 'reload') {
			location.href = kruddXrReloadHref();
			return;
		}
		if (state === 'enter') {
			var req = kruddXrFn('krudd_xr_request_session');
			if (!req)
				return;
			kruddXrRequestPending = true;
			kruddXrRequestDeadline = Date.now() + kruddXrRequestTimeoutMs;
			req();
			return;
		}
		if (state === 'exit') {
			var end = kruddXrFn('krudd_xr_end_session');
			if (!end)
				return;
			kruddXrEndedByUs = true;
			end();
		}
	}

	document.getElementById('xr-control').addEventListener('click', kruddXrClick);

	/*
	 * Runs every 500ms for the life of the page — two int32 calls into the
	 * module, cheap enough to leave running rather than tearing the poll
	 * down and back up around a session's lifetime. Two things only a poll
	 * can catch, because neither has a page-side event to listen for:
	 *
	 *   the probe's answer arriving (xr_supported() moving off UNKNOWN —
	 *   isSessionSupported() is a promise this page never awaited itself)
	 *
	 *   a session ending from OUTSIDE this page's own exit button — the
	 *   headset's system menu, or a failure mid-session — both of which
	 *   the browser only ever tells xr_session.c's "end" listener about,
	 *   never this page directly (xr.h's own note on why teardown has
	 *   exactly one path).
	 */
	function kruddXrPoll() {
		var supportedFn = kruddXrFn('krudd_xr_supported');
		var activeFn    = kruddXrFn('krudd_xr_session_active');
		var wasActive   = kruddXrSessionActive;

		if (!supportedFn || !activeFn)
			return;

		if (kruddXrSupport === -1) {
			kruddXrSupport = supportedFn();
			if (kruddXrSupport !== -1)
				kruddXrRender();
		}

		kruddXrSessionActive = !!activeFn();
		if (kruddXrSessionActive !== wasActive) {
			if (kruddXrSessionActive) {
				/* A session that just went live retires whatever an
				 * earlier click was trying to do: a pending request
				 * has its answer, and a stale "we asked for this
				 * exit" from a click whose end() never actually
				 * landed (session already gone, the call a no-op)
				 * must not suppress the note on THIS session's exit. */
				kruddXrRequestPending = false;
				kruddXrEndedByUs = false;
			}
			kruddXrRender();
		}

		if (wasActive && !kruddXrSessionActive) {
			if (!kruddXrEndedByUs)
				kruddXrNote('Left VR — back on the flat page. If ' +
					'that was not you (a dropped session, not the ' +
					'system menu), the reason is on the browser ' +
					'console, next to "xr:".');
			kruddXrEndedByUs = false;
		}

		if (kruddXrRequestPending && !kruddXrSessionActive &&
				Date.now() > kruddXrRequestDeadline) {
			kruddXrRequestPending = false;
			window.kruddShowError('VR session did not start',
				'The request did not turn into a session in time. ' +
				'The reason — refused, or the setup could not ' +
				'complete — is on the browser console, next to "xr:".');
		}
	}

	/*
	 * xr_probe() is "cheap and safe to call on any page" by its own
	 * contract (xr.h) — it still costs the one console line every page
	 * gets once support is known, and that line is only worth paying for
	 * on a browser that could plausibly answer yes. navigator.xr existing
	 * is that check: it is synchronous, needs no promise, and is false for
	 * the overwhelming majority of browsers this page ever loads in. Those
	 * never call into the module for this at all, which is the literal
	 * reading of "non-XR browsers see no console noise" — not "the module
	 * is quiet," but "this page never asks it to speak."
	 *
	 * Waits for Module._krudd_xr_probe to exist rather than assuming it:
	 * this script runs before {{{ SCRIPT }}} (the emcc loader) has
	 * necessarily produced any exports. Gives up silently after 30s — a
	 * module that never finishes loading has already said so through
	 * kruddSetRendererFailed or the error overlay; this has nothing to add.
	 */
	function kruddXrBoot() {
		var tries = 0;

		if (!(window.navigator && navigator.xr))
			return;

		var wait = setInterval(function () {
			var probe = kruddXrFn('krudd_xr_probe');

			tries++;
			if (!probe) {
				if (tries > 60)
					clearInterval(wait);
				return;
			}
			clearInterval(wait);
			probe();
			setInterval(kruddXrPoll, 500);
		}, 500);
	}

	kruddXrBoot();

	if ('serviceWorker' in navigator) {
		window.addEventListener('load', function () {
			navigator.serviceWorker.register('sw.js').catch(function () {});
		});
	}

</script>

<script>
var Module = {
	locateFile: function (path, prefix) {
		if (path.endsWith('.wasm'))
			return prefix + path.replace(/\.wasm$/, '.@GIT_COMMIT_HASH@.wasm');
		return prefix + path;
	}
};
</script>

{{{ SCRIPT }}}

</body>
</html>
